{
  "expo": {
    "name": "Pebble",
    "slug": "pebble",
    "scheme": "pebble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171B20"
    },
    "ios": {
      "bundleIdentifier": "io.github.viktormajor.pebble",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171B20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.viktormajor.pebble"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A28B73",
          "defaultChannel": "pebbles"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PebbleWidget",
              "displayName": "Pebble",
              "description": "A quiet view of your bowl.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "hu"],
            "android": ["en", "hu"]
          }
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "io.github.viktormajor.pebble.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.io.github.viktormajor.pebble"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "235f7282-1f1e-49e6-804b-57b076991115"
      }
    },
    "owner": "papmajorviktor"
  }
}
