# For a physical phone, replace YOUR_COMPUTER_LAN_IP with this computer's Wi-Fi/Ethernet IPv4 address.
# Do not use 127.0.0.1: that address resolves to the phone itself.
EXPO_PUBLIC_SUPABASE_URL=http://YOUR_COMPUTER_LAN_IP:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id
